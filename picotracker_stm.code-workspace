{
    "folders": [
        {
            "name": "picoTracker_STM",
            "path": "."
        }
    ],
    "settings": {
        "cmake.sourceDirectory": "${workspaceFolder:picoTracker_STM}/sources",
        "cmake.useCMakePresets": "always",
        "cmake.configureArgs": [
            "-DENABLE_LOGGING=OFF",
        ],
        "cortex-debug.variableUseNaturalFormat": true,
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "STM32 Debug",
                "cwd": "${workspaceFolder:picoTracker_STM}",
                "executable": "${command:cmake.launchTargetPath}",
                "request": "launch",
                "type": "cortex-debug",
                "servertype": "openocd",
                "device": "STM32H750",
                "configFiles": [
                    "interface/stlink.cfg",
                    "target/stm32h7x_dual_bank.cfg"
                ],
                "searchDir": [
                    "${env:OPENOCD_SCRIPTS}"
                ],
                "openOCDLaunchCommands": [
                    "set DUAL_BANK 1",
                    "adapter speed 5000",
                ],
                "gdbPath": "/usr/bin/gdb",
                "toolchainPrefix": "arm-none-eabi",
                "showDevDebugOutput": "raw",
                "overrideLaunchCommands": [
                    "monitor reset halt",
                    "load",
                    "monitor reset halt"
                ]
            },
            {
                "name": "STM32 Release",
                "cwd": "${workspaceFolder:picoTracker_STM}",
                "executable": "${workspaceFolder:picoTracker_STM}/build-opt/Adapters/adv/picoTrackerAdvance.elf",
                "request": "launch",
                "type": "cortex-debug",
                "servertype": "openocd",
                "device": "STM32H750",
                "configFiles": [
                    "interface/stlink.cfg",
                    "target/stm32h7x_dual_bank.cfg"
                ],
                "searchDir": [
                    "${env:OPENOCD_SCRIPTS}"
                ],
                "openOCDLaunchCommands": [
                    "set DUAL_BANK 1",
                    "adapter speed 5000",
                ],
                "gdbPath": "/usr/bin/gdb",
                "toolchainPrefix": "arm-none-eabi",
                "showDevDebugOutput": "raw",
                "overrideLaunchCommands": [
                    "monitor reset halt",
                    "load",
                    "monitor reset halt"
                ]
            },
        ],
        "compounds": []
    },
}
